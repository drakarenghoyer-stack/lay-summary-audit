{
  "trial_id": "SYNTH-001",
  "condition": "type 2 diabetes with established cardiovascular disease",
  "intervention": "synthemide 15 mg once daily",
  "comparator": "placebo",
  "design": "randomised, double-blind, placebo-controlled",
  "arms": [
    { "name": "intervention", "n": 2400 },
    { "name": "placebo", "n": 2398 }
  ],
  "outcomes": [
    {
      "rank": "primary",
      "measure": "3-point MACE (cardiovascular death, non-fatal MI, non-fatal stroke) at 104 weeks",
      "effect_type": "hazard_ratio",
      "point_estimate": 0.91,
      "ci_95": [0.79, 1.05],
      "p_value": 0.19,
      "significant": false,
      "multiplicity_adjusted": true
    },
    {
      "rank": "secondary",
      "measure": "change in HbA1c from baseline at 52 weeks (percentage points)",
      "effect_type": "mean_difference",
      "point_estimate": -0.68,
      "ci_95": [-0.81, -0.55],
      "p_value": 0.0001,
      "significant": true,
      "multiplicity_adjusted": false
    }
  ],
  "adverse_events": [
    { "term": "nausea", "intervention_pct": 22.4, "placebo_pct": 9.1 },
    { "term": "hypoglycaemia", "intervention_pct": 4.8, "placebo_pct": 3.9 },
    { "term": "acute pancreatitis", "intervention_pct": 0.4, "placebo_pct": 0.2 }
  ]
}
